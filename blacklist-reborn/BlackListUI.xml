	<!--
		"Add Player" name prompt. Our own dialog rather than a StaticPopup: showing a StaticPopup from
		addon code leaves the shared StaticPopup frames tainted for the Blizzard dialogs that reuse them.
	-->
	<Frame name="BlackListNameDialog" toplevel="true" frameStrata="DIALOG" parent="UIParent" enableMouse="true" hidden="true">
		<Size><AbsDimension x="320" y="110" /></Size>
		<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-135" /></Offset></Anchor></Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11" /></BackgroundInsets>
			<TileSize><AbsValue val="32" /></TileSize>
			<EdgeSize><AbsValue val="32" /></EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="BlackListNameDialogText" inherits="GameFontHighlight" text="BL_ENTER_NAME">
					<Size><AbsDimension x="290" y="16" /></Size>
					<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-18" /></Offset></Anchor></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox name="BlackListNameDialogEditBox" inherits="InputBoxTemplate" letters="60" autoFocus="false">
				<Size><AbsDimension x="200" y="32" /></Size>
				<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-36" /></Offset></Anchor></Anchors>
				<Scripts>
					<OnEnterPressed>BlackList:AcceptNameDialog();</OnEnterPressed>
					<OnEscapePressed>BlackListNameDialog:Hide();</OnEscapePressed>
				</Scripts>
			</EditBox>
			<Button name="BlackListNameDialogAcceptButton" inherits="UIPanelButtonTemplate" text="ACCEPT">
				<Size><AbsDimension x="110" y="22" /></Size>
				<Anchors><Anchor point="BOTTOM"><Offset><AbsDimension x="-60" y="16" /></Offset></Anchor></Anchors>
				<Scripts>
					<OnClick>BlackList:AcceptNameDialog();</OnClick>
				</Scripts>
			</Button>
			<Button name="BlackListNameDialogCancelButton" inherits="UIPanelButtonTemplate" text="CANCEL">
				<Size><AbsDimension x="110" y="22" /></Size>
				<Anchors><Anchor point="BOTTOM"><Offset><AbsDimension x="60" y="16" /></Offset></Anchor></Anchors>
				<Scripts>
					<OnClick>BlackListNameDialog:Hide();</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnShow>
				BlackListNameDialogEditBox:SetText("");
				BlackListNameDialogEditBox:SetFocus();
			</OnShow>
			<OnHide>BlackListNameDialogEditBox:ClearFocus();</OnHide>
		</Scripts>
	</Frame>

	<Frame name="BlackListTopFrame" parent="UIParent" hidden="true">
		<Scripts>
			<OnLoad>BlackList:OnLoad(self);</OnLoad>
			<OnEvent>BlackList:HandleEvent(event, ...);</OnEvent>
		</Scripts>
	</Frame>
</Ui>
